# Application Configuration
APP_NAME=SwiftPY
APP_ENV=local
APP_KEY=
# Keep APP_DEBUG=false in staging/production; enable only for local debugging.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Server (Uvicorn) & HTTP Proxy Trust
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=true
TRUSTED_PROXIES=

# Database (PostgreSQL / asyncpg)
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=swiftpy
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSL=disable
DB_SSL_CA_FILE=
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_LIFETIME=300.0
DB_COMMAND_TIMEOUT=60.0
DB_CONNECT_TIMEOUT=10.0
DB_STATEMENT_TIMEOUT=30.0
DB_TRANSACTION_TIMEOUT=60.0

# Redis (Shared or dedicated instances)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_EVENTS_DB=2

# Cache
CACHE_DRIVER=redis
CACHE_PREFIX=swiftpy_cache:
CACHE_DEFAULT_TTL=3600

# Queue
QUEUE_DRIVER=redis
QUEUE_PREFIX=swiftpy_queue:
QUEUE_NAME=default

# Task Scheduler
SCHEDULE_DRIVER=redis
SCHEDULE_TIMEZONE=UTC
SCHEDULE_AUTO_START=false
SCHEDULE_POLL_INTERVAL=1.0
SCHEDULE_GRACE_SECONDS=60.0
SCHEDULE_DISPATCH_LEASE_SECONDS=30.0
SCHEDULE_MAX_DISPATCH_ATTEMPTS=5
SCHEDULE_DEFAULT_LOCK_TTL=900
SCHEDULE_PREFIX=swiftpy_schedule:

# Filesystems & Storage
FILESYSTEM_DISK=local
STORAGE_LOCAL_ROOT=storage/app/private
STORAGE_PUBLIC_ROOT=storage/app/public
STORAGE_PUBLIC_URL=/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# Mail Subsystem
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_TIMEOUT=30.0
MAIL_VALIDATE_CERTS=true
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Authentication & Security
AUTH_GUARD=jwt
AUTH_BLACKLIST_ENABLED=true
AUTH_HYDRATE_USER=false
AUTH_PASSIVE_RESOLUTION=false
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
AUTH_KEY_PEPPER=
AUTH_REMEMBER_COOKIE=swiftpy_remember
AUTH_REMEMBER_TTL=2592000
AUTH_THROTTLE_ENABLED=true
AUTH_THROTTLE_MAX_ATTEMPTS=5
AUTH_THROTTLE_DECAY_SECONDS=60
AUTH_THROTTLE_LOCKOUT_SECONDS=60
AUTH_THROTTLE_IDENTIFIER_MAX_ATTEMPTS=0
AUTH_THROTTLE_IDENTIFIER_WINDOW_SECONDS=3600

# CORS (use explicit comma-separated origins; never pair '*' with CORS_ALLOW_CREDENTIALS=true)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# AI Subsystem
AI_ENABLED=true
AI_DEFAULT_PROVIDER=openai
AI_PROMPTS_PATH=prompts
AI_PROMPTS_CACHE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

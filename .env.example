DB_CONNECTION=postgresql

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=swiftpy
DB_USERNAME=postgres
DB_PASSWORD=secret

DB_SSL=false

DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_LIFETIME=300

DB_COMMAND_TIMEOUT=60
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30
DB_TRANSACTION_TIMEOUT=60